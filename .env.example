# Database
DATABASE_URL=postgresql://supply_user:supply_pass@localhost:5432/supply_pulse

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# Model Settings
MODEL_PATH=./model_artifacts/ensemble.pkl
MODEL_VERSION=1.0.0

# Rate Limiting (requests per IP per minute)
RATE_LIMIT=300

# Drift Detection
DRIFT_P_VALUE_THRESHOLD=0.05
DRIFT_MIN_SAMPLE_SIZE=30

# Service Level for Inventory Calculations
DEFAULT_SERVICE_LEVEL=0.95

# Logging
LOG_LEVEL=INFO
